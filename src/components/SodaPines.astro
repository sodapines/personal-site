---
const pines = [
  { x: 70, base: 200, width: 62, height: 128, fill: "var(--pine-far)" },
  { x: 250, base: 200, width: 70, height: 146, fill: "var(--pine-far)" },
  { x: 130, base: 200, width: 84, height: 164, fill: "var(--pine-near)" },
  { x: 195, base: 200, width: 66, height: 112, fill: "var(--accent)" },
];

const bubbles = [
  [34, 62, 5],
  [58, 34, 3],
  [190, 24, 6],
  [224, 52, 3],
  [282, 28, 4],
  [100, 22, 4],
];

// three stacked triangles, each tier wider and lower than the last
function pinePath({ x, base, width, height }: (typeof pines)[number]) {
  return [0, 1, 2]
    .map((tier) => {
      const top = base - height + tier * height * 0.26;
      const bottom = top + height * 0.5;
      const half = (width / 2) * (0.6 + tier * 0.2);
      return `M${x} ${top}L${x + half} ${bottom}H${x - half}Z`;
    })
    .join("");
}
---

<svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMax meet" role="img" aria-label="Pine trees with soda bubbles rising around them">
  <g fill="none" stroke="var(--clay)" stroke-width="1.5">
    {bubbles.map(([cx, cy, r]) => <circle class="bubble" cx={cx} cy={cy} r={r} />)}
  </g>
  {pines.map((pine) => <path d={pinePath(pine)} fill={pine.fill} />)}
  <rect x="0" y="198" width="320" height="2" fill="var(--pine-near)" />
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bubble {
    animation: rise 5s ease-in-out infinite alternate;
  }

  .bubble:nth-child(even) {
    animation-delay: -2s;
  }

  @keyframes rise {
    to {
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
  }
</style>
